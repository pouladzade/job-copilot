    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "@nestjs/swagger": "^11.1.5"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}