{
  "manifest_version": 3,
  "name": "AI Job Copilot",
  "version": "0.1.0",
  "description": "Local-first AI job application assistant. Scrapes, tailors, and fills — never submits.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:4000/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Job Copilot"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:4000"
  }
}